{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/protocoles/", "destination": "/sante/", "permanent": true },
    { "source": "/recettes/", "destination": "/fait-maison/", "permanent": true },
    { "source": "/cuisine-sacree/", "destination": "/fait-maison/", "permanent": true },
    { "source": "/eveil/", "destination": "/developpement-personnel/", "permanent": true },
    { "source": "/coups-de-coeur/", "destination": "/bons-plans/", "permanent": true },
    { "source": "/guides/", "destination": "/blog/", "permanent": true },
    { "source": "/articles/rituel-matinal-aligne/", "destination": "/developpement-personnel/combien-de-temps-pour-creer-une-habitude/", "permanent": true },
    { "source": "/articles/equilibrer-7-chakras/", "destination": "/developpement-personnel/", "permanent": true },
    { "source": "/articles/elixir-ortie-grand-mere/", "destination": "/fait-maison/", "permanent": true },
    { "source": "/:path*/index.html", "destination": "/:path*/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
