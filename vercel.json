{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/protocoles/",
      "destination": "/sante/",
      "permanent": true
    },
    {
      "source": "/recettes/",
      "destination": "/recettes-grand-mere/",
      "permanent": true
    },
    {
      "source": "/cuisine-sacree/",
      "destination": "/recettes-grand-mere/",
      "permanent": true
    },
    {
      "source": "/eveil/",
      "destination": "/developpement-personnel/",
      "permanent": true
    },
    {
      "source": "/coups-de-coeur/",
      "destination": "/bons-plans/",
      "permanent": true
    },
    {
      "source": "/guides/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/articles/rituel-matinal-aligne/",
      "destination": "/developpement-personnel/combien-de-temps-pour-creer-une-habitude/",
      "permanent": true
    },
    {
      "source": "/articles/equilibrer-7-chakras/",
      "destination": "/developpement-personnel/",
      "permanent": true
    },
    {
      "source": "/articles/elixir-ortie-grand-mere/",
      "destination": "/recettes-grand-mere/",
      "permanent": true
    },
    {
      "source": "/fait-maison/",
      "destination": "/recettes-grand-mere/",
      "permanent": true
    },
    {
      "source": "/fait-maison/granola-maison-peu-sucre/",
      "destination": "/recettes-grand-mere/granola-maison-peu-sucre/",
      "permanent": true
    },
    {
      "source": "/fait-maison/deodorant-maison-sans-bicarbonate/",
      "destination": "/beaute-naturelle/deodorant-maison-sans-bicarbonate/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}