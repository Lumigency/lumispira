---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Evidence from '../../components/Evidence.astro';
import Fiche from '../../components/Fiche.astro';
import Illus from '../../components/Illus.astro';
import Ingredients from '../../components/Ingredients.astro';
import { img, srcset, creditLinks } from '../../lib/unsplash';
import { getCollection, render } from 'astro:content';
import { AUTHORS, CATEGORIES, REVIEWERS, SITE, authorUrl, type AuthorKey } from '../../config/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { category: a.data.category, slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const d = article.data;
const { Content, headings } = await render(article);
const cat = CATEGORIES[d.category];
const author = AUTHORS[d.author];
const authorHref = authorUrl(d.author);
// Relecteur : clé de REVIEWERS ou objet { name, title }
const reviewer = typeof d.reviewer === 'string' ? REVIEWERS[d.reviewer] : d.reviewer;
// Encadré « On a testé »
const note = typeof d.personalNote === 'string' ? { by: d.author as AuthorKey, text: d.personalNote } : d.personalNote;
const noteAuthor = note ? AUTHORS[note.by] : null;
const url = `${SITE.url}/${d.category}/${article.id}/`;
const cover = d.cover;
const shareImage = cover ? img(cover.id, 1200, 630) : `${SITE.url}/og-default.png`;
// Google recommande plusieurs formats d'image pour les résultats enrichis
const schemaImages = cover ? [img(cover.id, 1200, 675), img(cover.id, 1200, 900), img(cover.id, 1200, 1200)] : [`${SITE.url}/og-default.png`];
const credit = cover ? creditLinks(cover.handle) : null;
const fmt = (date: Date) => date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);

const words = article.body?.split(/\s+/).length ?? 0;
const minutes = d.readingTime ?? Math.max(3, Math.round(words / 220));

// À lire ensuite : sujets en commun d'abord, puis même rubrique, puis le plus récent
const selfUrl = `/${d.category}/${article.id}/`;
const relScore = (a: typeof article) =>
  a.data.topics.filter((t) => d.topics.includes(t)).length * 3 +
  (a.data.category === d.category ? 2 : 0) +
  // articles déjà liés entre eux dans le texte : sujets proches
  ((article.body ?? '').includes(`/${a.data.category}/${a.id}/`) || (a.body ?? '').includes(selfUrl) ? 2 : 0);
const related = (await getCollection('articles', (a) => a.id !== article.id))
  .sort((a, b) => relScore(b) - relScore(a) || (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf())
  .slice(0, 3);

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': d.category === 'sante' || d.category === 'peau-acne' ? 'MedicalWebPage' : 'Article',
  headline: d.title,
  description: d.description,
  url,
  mainEntityOfPage: url,
  inLanguage: 'fr-FR',
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: author.kind === 'team'
    ? { '@type': 'Organization', name: `${author.name} ${SITE.name}`, url: `${SITE.url}/redaction/` }
    : { '@type': 'Person', name: author.name, url: `${SITE.url}${authorHref}`, jobTitle: author.role, worksFor: { '@id': `${SITE.url}/#organization` } },
  publisher: { '@id': `${SITE.url}/#organization` },
  image: schemaImages,
  articleSection: cat.name,
  keywords: d.topics.join(', '),
  citation: d.sources.filter((s) => s.url).map((s) => s.url),
};
if (reviewer) {
  articleLd.reviewedBy = { '@type': 'Person', name: reviewer.name, jobTitle: reviewer.title, ...(reviewer.url ? { sameAs: [reviewer.url] } : {}) };
  articleLd.lastReviewed = (d.updated ?? d.date).toISOString();
}
const jsonLd: object[] = [articleLd];
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const iso = (s: string) => {
  const m = s.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!m) return s;
  const h = Number(m[1] ?? 0), mn = Number(m[2] ?? 0);
  return [h ? `${h} h` : '', mn ? `${mn} min` : ''].filter(Boolean).join(' ');
};
const mins = (s: string) => { const m = s.match(/PT(?:(\d+)H)?(?:(\d+)M)?/); return m ? Number(m[1] ?? 0) * 60 + Number(m[2] ?? 0) : 0; };
const totalTime = (a: string, b: string) => { const t = mins(a) + mins(b); return `PT${Math.floor(t / 60) ? Math.floor(t / 60) + 'H' : ''}${t % 60 ? (t % 60) + 'M' : ''}`; };
if (d.recipe && d.recipe.kind === 'food') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Recipe',
    name: d.title,
    description: d.description,
    author: author.kind === 'team' ? { '@type': 'Organization', name: `${author.name} ${SITE.name}` } : { '@type': 'Person', name: author.name },
    datePublished: d.date.toISOString(),
    prepTime: d.recipe.prepTime,
    totalTime: totalTime(d.recipe.prepTime, d.recipe.cookTime),
    recipeCategory: d.recipe.recipeCategory,
    recipeCuisine: d.recipe.recipeCuisine,
    keywords: d.recipe.keywords,
    cookTime: d.recipe.cookTime,
    recipeYield: d.recipe.yield,
    recipeIngredient: d.recipe.ingredients,
    recipeInstructions: d.recipe.steps.map((s) => ({ '@type': 'HowToStep', text: s })),
    image: schemaImages,
  });
}
---
<Base title={d.seoTitle ?? d.title} description={d.description} type="article" jsonLd={jsonLd} published={d.date} modified={d.updated ?? d.date} image={shareImage} imageAlt={cover?.alt} section={cat.name} tags={d.topics}>
  <article>
    <header class="article-head tinted" style={`--tint:${d.category === 'bons-plans' ? 'var(--pollen-soft)' : cat.soft}`}>
      <div class="wrap">
        <Crumbs items={[{ name: cat.name, href: `/${d.category}/` }, { name: d.title, href: `/${d.category}/${article.id}/` }]} />
        <div class="article-head-grid">
          <div>
            <h1>{d.title}</h1>
            <p class="lede">{d.description}</p>
          </div>
          <Illus name={d.category} class="article-head-illus" />
        </div>
        <div class="byline">
          <span>Par <a href={authorHref}>{author.kind === 'team' ? 'la rédaction' : author.name}</a>{author.kind === 'person' && <>, {author.role.toLowerCase()}</>}</span>
          {reviewer && <span>Relu par <b>{reviewer.name}</b>, {reviewer.title}</span>}
          <span>{d.updated ? `Mis à jour le ${fmt(d.updated)}` : `Publié le ${fmt(d.date)}`}</span>
          <span>{minutes} min de lecture</span>
        </div>
      </div>
    </header>

    {cover && credit && (
      <figure class="wrap article-cover">
        <img src={img(cover.id, 1400, 600)} srcset={srcset(cover.id, [640, 960, 1400, 1920], 1400 / 600)} sizes="(max-width: 1280px) 100vw, 1240px" width="1400" height="600" alt={cover.alt} fetchpriority="high" decoding="async" />
        <figcaption>Photo : <a href={credit.author} rel="noopener">{cover.credit}</a> sur <a href={credit.unsplash} rel="noopener">Unsplash</a></figcaption>
      </figure>
    )}
    <div class="wrap article-grid">
      <div>
        {d.affiliate && (
          <p class="disclosure">Cet article contient des liens d'affiliation. Si tu achètes via ces liens, nous touchons une commission sans surcoût pour toi. Les produits sont choisis selon <a href="/transparence/">notre méthode</a>, jamais par les marques.</p>
        )}

        <section class="verdict-box" aria-labelledby="verdict">
          <h2 id="verdict">Notre verdict en bref</h2>
          <p>{d.verdict}</p>
          {d.keyPoints.length > 0 && <ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul>}
        </section>

        {d.evidence && <Evidence claim={d.evidence.claim} level={d.evidence.level} />}

        {d.recipe && <Ingredients items={d.recipe.ingredients} kind={d.recipe.kind} />}

        <div class="prose">
          <Content />
          {d.recipe && (
            <section class="recipe-card" id="recette" aria-labelledby="recipe-title">
              <h2 id="recipe-title">{d.recipe.kind === 'food' ? 'La recette' : 'La formule'}</h2>
              <div class="recipe-meta">
                <span>Préparation <b>{iso(d.recipe.prepTime)}</b></span>
                <span>{d.recipe.kind === 'food' ? 'Cuisson' : 'Chauffe'} <b>{iso(d.recipe.cookTime)}</b></span>
                <span>Pour <b>{d.recipe.yield}</b></span>
              </div>
              <h3>Ingrédients</h3>
              <ul>{d.recipe.ingredients.map((i) => <li>{i}</li>)}</ul>
              <h3>Étapes</h3>
              <ol>{d.recipe.steps.map((s) => <li>{s}</li>)}</ol>
            </section>
          )}
        </div>

        {note && noteAuthor && (
          <aside class="personal-note" aria-label="On a testé">
            <div class="avatar" aria-hidden="true">{noteAuthor.initials}</div>
            <div>
              <p class="personal-note-title">On a testé</p>
              <p>{note.text}</p>
              <p class="personal-note-by">{noteAuthor.kind === 'team' ? 'La rédaction' : `${noteAuthor.name}, ${noteAuthor.role.toLowerCase()}`}</p>
            </div>
          </aside>
        )}

        {d.healthWarning && (
          <p class="health-note">Cet article informe, il ne remplace pas un avis médical. Avant de commencer un complément, surtout si tu prends un traitement, es enceinte ou allaites, parles-en à ton médecin ou ton pharmacien. Un effet indésirable lié à un complément peut être déclaré sur le portail de nutrivigilance de l'Anses.</p>
        )}

        {d.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title">Questions fréquentes</h2>
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </section>
        )}

        {d.sources.length > 0 && (
          <section class="sources" aria-labelledby="src-title">
            <h2 id="src-title">Sources</h2>
            <ol>{d.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener">{s.label}</a> : s.label}</li>)}</ol>
          </section>
        )}

        <section class="author-box" aria-label="À propos de l'auteur">
          <div class="avatar" aria-hidden="true">{author.initials}</div>
          <div>
            <a href={authorHref}><b>{author.kind === 'team' ? `${author.name} ${SITE.name}` : author.name}</b></a>{author.kind === 'person' && <>, {author.role.toLowerCase()}</>}
            <p>{author.bio}</p>
            {reviewer && <p><b>Relecture :</b> {reviewer.name}, {reviewer.title}.</p>}
            <p class="author-box-team">Lumispira est un média indépendant : découvre <a href="/redaction/">la rédaction</a> et <a href="/methode/">notre méthode</a>.</p>
          </div>
        </section>
      </div>

      <aside class="article-aside">
        <div class="side-sticky">
          {toc.length > 2 && (
            <nav class="side-box toc" aria-label="Sommaire">
              <h2>Sommaire</h2>
              <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
          <div class="side-box pollen">
            <h2>Les bons plans</h2>
            <p>Les offres du moment sur les produits qu'on recommande vraiment.</p>
            <a href="/bons-plans/" style="font-size:var(--t-sm)">Voir les bons plans</a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <section class="section" style="border-top:1px solid var(--line);padding-top:3rem">
    <div class="wrap">
      <div class="section-head"><h2 style="font-size:var(--t-lg)">À lire ensuite</h2></div>
      <ul class="fiche-list">{related.map((a) => <Fiche article={a} />)}</ul>
    </div>
  </section>
</Base>
