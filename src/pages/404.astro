---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex newsletter={false}>
  <section class="page-head" style="border:0;padding-bottom:5rem">
    <div class="wrap">
      <h1>Cette page n'est pas passée au tamis.</h1>
      <p class="lede">Elle a peut-être été déplacée ou n'a jamais existé. Les articles sont tous ici :</p>
      <p style="margin-top:1.5rem;display:flex;gap:.75rem;flex-wrap:wrap"><a class="btn" href="/blog/">Voir tous les articles</a><a class="btn btn-ghost" href="/">Retour à l'accueil</a></p>
    </div>
  </section>
</Base>
