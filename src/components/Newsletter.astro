---
// Formulaire prêt à brancher (Brevo) : remplacer l'attribut action par l'URL du formulaire Brevo.
import Illus from './Illus.astro';
---
<section class="newsletter" aria-labelledby="nl-title">
  <div class="wrap">
    <Illus name="newsletter" class="nl-illus" />
    <div>
      <h2 id="nl-title">Le tri de la semaine, chaque dimanche</h2>
      <p>Un sujet passé au tamis, une recette maison, et les vrais bons plans du moment. Pas de promo déguisée.</p>
    </div>
    <form class="nl-form" action="#" method="post">
      <label for="nl-email">Ton adresse e-mail</label>
      <input id="nl-email" name="email" type="email" autocomplete="email" required placeholder="prenom@exemple.fr" />
      <button class="btn" type="submit">Je m'inscris</button>
      <small>Désinscription en un clic. Tes données ne sont jamais revendues.</small>
    </form>
  </div>
</section>
